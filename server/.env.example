# ---- Server ----
PORT=4000
# Public URL of this API (used for gateway success/fail/cancel callbacks)
SERVER_URL=http://localhost:4000
# Where customers land after payment (Vite dev server, or same as SERVER_URL in production)
CLIENT_URL=http://localhost:5173
# Server-to-server IPN needs a publicly reachable URL (e.g. via ngrok). Leave empty on localhost.
IPN_BASE_URL=
# 32+ random chars — encrypts merchant gateway secrets at rest
APP_SECRET=change-me-to-a-long-random-string
DATA_FILE=./data/db.json
# When a gateway is unreachable, fall back to the built-in payment simulator (dev only)
PG_FALLBACK_SIMULATOR=true

# ---- Platform payment gateway (used for merchants on "platform" collection mode) ----
# Public SSLCOMMERZ sandbox store; replace with your live store for production.
SSLCZ_STORE_ID=testbox
SSLCZ_STORE_PASSWORD=qwerty
SSLCZ_SANDBOX=true
