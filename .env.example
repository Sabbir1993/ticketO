# ─────────────────────────────────────────────────────────────────────────────
# Ticketo — environment. Copy to .env and fill in. NEVER commit .env.
# Only bootstrap secrets live here. Gateway / SMS / SMTP credentials are entered
# in the CMS and stored encrypted (AES-256-GCM) — never in plain text.
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME=Ticketo
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:3333
APP_PORT=3333
APP_LOCALE=en

# node artisan key:generate
APP_KEY=[PLACEHOLDER]

# Envelope-encryption key-encryption keys. Comma separated "version:base64key" (32 bytes each).
# The LAST entry encrypts new data; older versions stay for decrypting until rotated.
# node artisan ticketo:keys:generate
ENCRYPTION_KEKS=[PLACEHOLDER]
# HMAC keys (32+ random bytes, base64)
TICKET_SIGNING_KEY=[PLACEHOLDER]
SESSION_PEPPER=[PLACEHOLDER]

# ---- MySQL ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ticketo
DB_USERNAME=[PLACEHOLDER]
DB_PASSWORD=[PLACEHOLDER]
DB_TIMEZONE=+06:00

# ---- HTTP / security ----
# Comma separated IPs or CIDRs of reverse proxies whose X-Forwarded-For we trust
TRUSTED_PROXIES=127.0.0.1,::1
CORS_ALLOWED_ORIGINS=http://localhost:3333,http://localhost:5173
SESSION_COOKIE=ticketo_session
SESSION_LIFETIME_DAYS=30
SESSION_IDLE_MINUTES=720
CMS_SESSION_IDLE_MINUTES=30
# Vite dev server used by the Edge shell in local development
VITE_DEV_URL=http://localhost:5173

# ---- Payments ----
# Callback base (public URL of this app). IPN needs a public URL (tunnel in dev).
PUBLIC_URL=http://localhost:3333
IPN_BASE_URL=
# Sandbox payment simulator — dev/offline only. Never registered when APP_ENV=production.
PAYMENT_SIMULATOR=true

# SSLCOMMERZ endpoints — these decide SANDBOX vs LIVE (https://*.sslcommerz.com only).
#   sandbox: https://sandbox.sslcommerz.com/gwprocess/v4/api.php
#            https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php
#   live:    https://securepay.sslcommerz.com/gwprocess/v4/api.php
#            https://securepay.sslcommerz.com/validator/api/validationserverAPI.php
SSLCZ_INIT_URL=https://sandbox.sslcommerz.com/gwprocess/v4/api.php
SSLCZ_VALIDATION_URL=https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php
# Store ID / password are not set here: each merchant enters them (default store + optional per-event store), stored encrypted.

# ---- Infra ----
CACHE_DRIVER=memory
QUEUE_CONNECTION=database
REDIS_URL=
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_LEVEL=info
MAIL_MAILER=log
