{
  "name": "ticketo",
  "version": "1.0.0",
  "private": true,
  "description": "Ticketo — multi-merchant event ticketing platform (LaraNode + MySQL + React)",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node scripts/dev.js",
    "serve": "node artisan serve",
    "vite": "vite --config vite.config.mjs",
    "build:logviewer": "tailwindcss --content ./vendor/laranode/framework/src/Log/LogViewerController.js -o ./public/vendor/log-viewer.css --minify",
    "build": "vite build --config vite.config.mjs",
    "start": "node server.js",
    "migrate": "node artisan migrate",
    "seed": "node artisan db:seed",
    "test": "node artisan test"
  },
  "overrides": {
    "diff": ">=8.0.3",
    "serialize-javascript": ">=7.0.4"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "commander": "^14.0.3",
    "connect-flash": "^0.1.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-fileupload": "^1.5.2",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.0",
    "method-override": "^3.0.0",
    "mime-types": "^3.0.2",
    "mysql2": "^3.18.2",
    "nodemailer": "^8.0.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "chai": "^6.2.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.47.0",
    "mocha": "^11.7.5",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.28",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19",
    "vite": "^6.4.3"
  }
}
